{
  "manifest_version": 3,
  "name": "Gaze-Aware Playback",
  "version": "0.1.0",
  "description": "視線(顔向き)検出でYouTube/Prime Videoの動画を自動一時停止するChrome拡張機能",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": ["offscreen"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.co.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.co.jp/*"
      ],
      "js": ["src/content/content-script.ts"]
    }
  ]
}
